# One origin for the app and the API — the same shape as nginx.conf, which still
# serves local development.
#
# SITE_ADDRESS decides who holds the certificate:
#   a hostname   Caddy gets one from Let's Encrypt and renews it (docker-compose.prod.yml)
#   :80          something in front terminates TLS (docker-compose.funnel.yml)

{$SITE_ADDRESS} {
	encode zstd gzip

	# Not handle_path: the API's routes include the /api prefix, so stripping it
	# here would 404 every request.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		@static path *.js *.css *.woff *.woff2 *.png *.svg *.ico
		header @static Cache-Control "public, max-age=2592000, immutable"
		# Angular is a single-page app: unknown paths fall through to index.html.
		try_files {path} /index.html
		file_server
	}
}
