# Postgres
POSTGRES_DB=moss
POSTGRES_USER=moss
POSTGRES_PASSWORD=moss
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://moss:moss@db:5432/moss
BACKEND_PORT=8000

# The host other devices reach this machine on — your LAN IP. Keycloak, the API and
# the frontend are all published on it, and the browser derives their URLs from
# whatever address it was opened at. Leave as localhost for this machine only.
PUBLIC_HOST=localhost

# Keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_AUDIENCE=account

# Frontend / reverse proxy. Everything is served through one HTTPS origin, which is
# what makes the app work off this machine: browsers only expose crypto.subtle — needed
# by the PKCE login — on a secure context, and plain http:// on a LAN address is not one.
HTTP_PORT=80
HTTPS_PORT=443

# --- Deployed stack only (docker-compose.prod.yml) ---
# PUBLIC_HOST doubles as the deployed domain: it is Caddy's site address, the name it
# asks Let's Encrypt to certify, and Keycloak's fixed hostname. It must resolve to the
# server — an IP will not do, because Let's Encrypt will not certify one.
#
#   PUBLIC_HOST=moss-todo.duckdns.org
#
# Generate real secrets on the server, with `openssl rand -base64 24`. The defaults
# below are fine on localhost and are the whole security of a public deployment.
#   POSTGRES_PASSWORD=...
#   KEYCLOAK_ADMIN_PASSWORD=...

# --- Tailscale Funnel only (docker-compose.funnel.yml) ---
# Publishes the stack from this machine, with no server and no port forwarding.
# PUBLIC_HOST above becomes the funnel address: <TS_HOSTNAME>.<your-tailnet>.ts.net
# (the tailnet name is on the admin console's DNS page).
#   TS_HOSTNAME=moss-todo
#   TS_AUTHKEY=tskey-auth-...      # reusable key, login.tailscale.com/admin/settings/keys
