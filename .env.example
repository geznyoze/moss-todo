# Postgres
POSTGRES_DB=moss
POSTGRES_USER=moss
POSTGRES_PASSWORD=moss
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://moss:moss@db:5432/moss
BACKEND_PORT=8000

# The host other devices reach this machine on — your LAN IP. The API and the frontend
# are both published on it, and the browser derives their URLs from whatever address it
# was opened at. Leave as localhost for this machine only.
PUBLIC_HOST=localhost

# Signs the session tokens. This value is public — replace it anywhere that matters.
JWT_SECRET=dev-only-insecure-secret

# Frontend / reverse proxy. Everything is served through one HTTPS origin, so there is
# one certificate to trust and one port to forward.
HTTP_PORT=80
HTTPS_PORT=443

# --- Deployed stack only (docker-compose.prod.yml) ---
# PUBLIC_HOST doubles as the deployed domain: it is Caddy's site address, the name it
# asks Let's Encrypt to certify, and Keycloak's fixed hostname. It must resolve to the
# server — an IP will not do, because Let's Encrypt will not certify one.
#
#   PUBLIC_HOST=moss-todo.duckdns.org
#
# Generate real secrets on the server, with `openssl rand -hex 32`. The defaults above
# are fine on localhost and are the whole security of a public deployment. The prod
# overlay will not start without JWT_SECRET set.
#   POSTGRES_PASSWORD=...
#   JWT_SECRET=...

# --- Tailscale Funnel only (docker-compose.funnel.yml) ---
# Publishes the stack from this machine, with no server and no port forwarding.
# PUBLIC_HOST above becomes the funnel address: <TS_HOSTNAME>.<your-tailnet>.ts.net
# (the tailnet name is on the admin console's DNS page).
#   TS_HOSTNAME=moss-todo
#   TS_AUTHKEY=tskey-auth-...      # reusable key, login.tailscale.com/admin/settings/keys
