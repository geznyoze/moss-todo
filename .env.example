# Postgres
POSTGRES_DB=moss
POSTGRES_USER=moss
POSTGRES_PASSWORD=moss
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://moss:moss@db:5432/moss
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:4200

# Keycloak (issuer must be reachable under the SAME url from browser and backend)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER=http://localhost:8080/realms/moss
KEYCLOAK_AUDIENCE=account

# Frontend
FRONTEND_PORT=4200
